# --- Required: connection string (use a read-only role!) ---
PGQA_DATABASE_URL=postgresql://ask_postgres_reader:reader@localhost:55432/shop

# --- Optional guardrails ---
# Comma-separated schemas the agent may see/query (default: all non-system schemas)
# PGQA_SCHEMAS=sales
# PGQA_MAX_ROWS=200
# PGQA_STATEMENT_TIMEOUT_MS=15000
# Set false to hide raw rows (sample_rows / column_values tools) for sensitive data
# PGQA_ALLOW_SAMPLING=true

# --- HTTP API ---
# Require this key in X-API-Key or "Authorization: Bearer" headers
# PGQA_API_KEY=change-me

# =====================================================================================
# Built-in agent (ask-postgres ask / chat / POST /ask): BRING YOUR OWN LLM
# Not needed if you connect your own agent via MCP or the HTTP tool endpoints.
# Uncomment ONE recipe, then run `ask-postgres check-llm` to test it.
# ${VAR} reads another environment variable, so the key needn't be stored in this file.
# =====================================================================================
# PGQA_LLM_PROVIDER=auto          # anthropic | openai | gemini | package.module:ClassName | auto
# PGQA_LLM_MODEL=                 # model / deployment name as your provider or gateway names it
# PGQA_LLM_BASE_URL=              # leave empty for the provider's public API
# PGQA_LLM_API_KEY=               # empty = provider's usual variable (ANTHROPIC_API_KEY, OPENAI_API_KEY, GEMINI_API_KEY)
# PGQA_LLM_HEADERS={}             # extra HTTP headers as JSON, e.g. {"api-key": "..."} for gateways
# PGQA_LLM_EXTRA_PARAMS={}        # extra request parameters as JSON, e.g. {"temperature": 0}

# ---------------------------------------------------------------------- public APIs
# --- OpenAI
# PGQA_LLM_PROVIDER=openai
# PGQA_LLM_API_KEY=${OPENAI_API_KEY}
# PGQA_LLM_MODEL=<model name>

# --- Anthropic Claude
# PGQA_LLM_PROVIDER=anthropic
# PGQA_LLM_API_KEY=${ANTHROPIC_API_KEY}
# PGQA_LLM_MODEL=claude-opus-5-5
# PGQA_EFFORT=high                # Anthropic only

# --- Google Gemini (Google AI Studio key; for Vertex AI set GOOGLE_GENAI_USE_VERTEXAI=true instead)
# PGQA_LLM_PROVIDER=gemini
# PGQA_LLM_API_KEY=${GEMINI_API_KEY}
# PGQA_LLM_MODEL=gemini-3.8-flash

# --- Azure OpenAI (v1 endpoint; model = your deployment name)
# PGQA_LLM_PROVIDER=openai
# PGQA_LLM_BASE_URL=https://<resource>.openai.azure.com/openai/v1/
# PGQA_LLM_API_KEY=${AZURE_OPENAI_API_KEY}
# PGQA_LLM_MODEL=<deployment name>

# --- Other OpenAI-compatible services: OpenRouter, Groq, Mistral, Together, DeepSeek, ...
# PGQA_LLM_PROVIDER=openai
# PGQA_LLM_BASE_URL=<service base URL, usually ending in /v1>
# PGQA_LLM_API_KEY=<key>
# PGQA_LLM_MODEL=<model name>

# ---------------------------------------------------------------------- local / self-hosted
# --- Ollama (no key; data stays on the machine; pick a model with tool-calling support)
# PGQA_LLM_PROVIDER=openai
# PGQA_LLM_BASE_URL=http://localhost:11434/v1
# PGQA_LLM_MODEL=qwen3:14b

# --- LM Studio (http://localhost:1234/v1), vLLM / llama.cpp server (http://<host>:8000/v1): same as Ollama

# ---------------------------------------------------------------------- LLM gateways / proxies
# LiteLLM, Portkey, Kong, Azure API Management, Cloudflare AI Gateway, company gateways, ...
# A gateway exposes one or more API formats. Choose the provider by the FORMAT, not the model vendor:
#   /v1/chat/completions   -> PGQA_LLM_PROVIDER=openai     BASE_URL=https://<gateway>/v1
#   /v1/messages           -> PGQA_LLM_PROVIDER=anthropic  BASE_URL=https://<gateway>         (no /v1)
#   /v1beta/models/...     -> PGQA_LLM_PROVIDER=gemini     BASE_URL=https://<gateway>/v1beta  (keep the version)
# Use the model names the gateway lists. If it expects a non-standard auth header, add PGQA_LLM_HEADERS.
# PGQA_LLM_PROVIDER=openai
# PGQA_LLM_BASE_URL=https://<gateway>/v1
# PGQA_LLM_API_KEY=${LLM_GATEWAY_API_KEY}
# PGQA_LLM_MODEL=<model name from the gateway's catalog>

# PGQA_MAX_AGENT_TURNS=25
# PGQA_REFUSAL_FALLBACK=true      # Anthropic only; auto-disabled if the endpoint rejects it
